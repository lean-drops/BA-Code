/* /Users/programming/PycharmProjects/Find_Bibliography_NEw/style.qss
   Einfaches, dunkles Theme für citation_gui_zotero.py
*/

QMainWindow, QWidget {
    background-color: #1f2125;
    color: #e0e0e0;
    font-family: -apple-system, "SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 11pt;
}

/* Überschriften / Labels */

QLabel#PathLabel {
    color: #a8b2c3;
    font-size: 10pt;
}

QLabel#MetaLabel {
    font-weight: 500;
    color: #d0d5e0;
}

QLabel#SectionLabel {
    font-size: 11pt;
    font-weight: 600;
    margin-top: 4px;
    margin-bottom: 2px;
    color: #f0f0f0;
}

QLabel#FieldLabel {
    font-size: 10pt;
    font-weight: 500;
    color: #c7d0e0;
}

/* Buttons */

QPushButton {
    border-radius: 6px;
    padding: 6px 12px;
    border: 1px solid #3a3f4b;
    background-color: #2a2d34;
    color: #e0e0e0;
}

QPushButton:hover {
    background-color: #343843;
    border-color: #4a90e2;
}

QPushButton:pressed {
    background-color: #252830;
}

QPushButton:disabled {
    background-color: #2a2d34;
    color: #7b7f88;
    border-color: #2a2d34;
}

/* Primäre Buttons (oben rechts) */

QPushButton#PrimaryButton {
    background-color: #34495e;
    border-color: #34495e;
}

QPushButton#PrimaryButton:hover {
    background-color: #3f5d78;
    border-color: #4a90e2;
}

/* Speichern-Button */

QPushButton#AccentButton {
    background-color: #4a90e2;
    border-color: #4a90e2;
    color: #ffffff;
}

QPushButton#AccentButton:hover {
    background-color: #5ba0f0;
    border-color: #5ba0f0;
}

/* Sekundäre Buttons (Navigation, Zusatzfunktionen) */

QPushButton#SecondaryButton {
    background-color: #2a2d34;
    border-color: #3a3f4b;
}

/* Tabellen-Style */

QTableWidget#CitationTable {
    background-color: #262a30;
    gridline-color: #3a3f4b;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
    alternate-background-color: #2c3038;
}

QHeaderView::section {
    background-color: #2a2d34;
    color: #d0d0d0;
    padding: 4px 6px;
    border: 0px;
    border-right: 1px solid #3a3f4b;
}

QHeaderView::section:horizontal {
    border-bottom: 1px solid #3a3f4b;
}

/* Textfelder */

QTextEdit#SentenceViewer {
    background-color: #252830;
    border-radius: 6px;
    border: 1px solid #3a3f4b;
    padding: 6px;
}

QTextEdit#FootnoteEdit {
    background-color: #252830;
    border-radius: 6px;
    border: 1px solid #3a3f4b;
    padding: 6px;
}

QLineEdit#ZoteroKeyEdit,
QLineEdit {
    background-color: #252830;
    border-radius: 4px;
    border: 1px solid #3a3f4b;
    padding: 4px 6px;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

/* Splitter */

QSplitter#MainSplitter::handle {
    background-color: #1f2125;
    width: 4px;
}

QSplitter#MainSplitter::handle:horizontal:hover {
    background-color: #3a3f4b;
}

/* ListWidgets in Dialogen */

QListWidget {
    background-color: #252830;
    border-radius: 4px;
    border: 1px solid #3a3f4b;
}

QListWidget::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

/* Scrollbars */

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #1f2125;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #3a3f4b;
    min-height: 20px;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #4a90e2;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* Statusbar */

QStatusBar {
    background-color: #1b1c20;
    color: #a8b2c3;
}